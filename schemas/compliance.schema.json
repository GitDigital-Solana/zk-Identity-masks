{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Compliance Rule Set",
  "type": "object",
  "required": ["tokenMint", "rules"],
  "properties": {
    "tokenMint": { "type": "string" },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "value"],
        "properties": {
          "type": { "type": "string", "enum": ["kyc", "accredited", "jurisdiction", "lockup"] },
          "value": { "type": "string" }
        }
      }
    }
  }
}