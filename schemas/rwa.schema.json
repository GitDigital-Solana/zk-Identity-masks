{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RWA Token Metadata",
  "type": "object",
  "required": ["name", "symbol", "uri", "decimals", "assetClass", "jurisdiction", "compliance"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "symbol": { "type": "string", "minLength": 1, "maxLength": 10 },
    "uri": { "type": "string", "format": "uri" },
    "decimals": { "type": "integer", "minimum": 0, "maximum": 9 },
    "assetClass": {
      "type": "string",
      "enum": ["real-estate", "commodity", "private-equity", "bond", "fund", "collectible", "infrastructure"]
    },
    "jurisdiction": { "type": "string", "minLength": 2, "maxLength": 10 },
    "attributes": { "type": "object" },
    "compliance": {
      "type": "object",
      "required": ["kycRequired", "accreditedOnly"],
      "properties": {
        "kycRequired": { "type": "boolean" },
        "accreditedOnly": { "type": "boolean" }
      }
    }
  }
}